<?xml version="1.0"?>
<robot name="chrono_vehicle_split_6x6">

  <!--
    6x6 sibling of chrono_vehicle_split.urdf (the 4-wheel/2-axle split URDF)
    — that file is untouched. Same ChronoEcuBridgeSystemInterface plugin
    (it has zero FMU-specific knowledge, so needs no six_wheel <param> at
    all — unlike the in-process version's chrono_vehicle_6x6.urdf). The
    six_wheel flag for this track instead lives as a ROS2 node parameter
    on chrono_split_ecu/chrono_split_dynamics_node, set via the split
    launch file's six_wheel launch argument.

    Geometry matches chrono_vehicle_6x6.urdf exactly (see its own comment
    for the underlying native_vehicle_fmu constants) — both URDFs must
    describe the same physical vehicle regardless of which track drives it.
  -->

  <material name="chassis_red">
    <color rgba="0.75 0.1 0.1 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 1.19" rpy="0 0 0"/>
      <geometry>
        <box size="4.4 1.8 0.5"/>
      </geometry>
      <material name="chassis_red"/>
    </visual>
  </link>

  <link name="front_left_knuckle"/>
  <link name="front_right_knuckle"/>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="mid_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="mid_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="1.7 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="1.7 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="mid_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="mid_left_wheel"/>
    <origin xyz="0 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="mid_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="mid_right_wheel"/>
    <origin xyz="0 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-1.7 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-1.7 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="ChronoVehicleSystem" type="system">
    <hardware>
      <plugin>chrono_split_ecu_bridge_hw_interface/ChronoEcuBridgeSystemInterface</plugin>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_left_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
    <joint name="mid_left_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
    <joint name="mid_right_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
