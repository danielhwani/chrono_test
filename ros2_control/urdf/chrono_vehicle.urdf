<?xml version="1.0"?>
<robot name="chrono_vehicle">

  <!--
    Step 3 of the ros2_control prep plan (see README.md, "ros2_control 준비"
    sections): a MINIMAL URDF — joint topology + <ros2_control> tags, for
    the 4-wheel car case (fmu/cpp/native_vehicle_fmu/, not the 6x6 truck
    yet). The point is giving controller_manager/pluginlib something to
    load ChronoFmuSystemInterface against, not RViz/Gazebo rendering — so
    no <inertial> or <collision> (no physics runs on this URDF; Chrono
    already does all the physics, inside the FMU). <visual> geometry WAS
    added below (simple boxes/cylinders, purely cosmetic) so RViz's
    RobotModel display shows an actual vehicle shape instead of just TF
    axes — same box/cylinder dimensions simple_vehicle.py's make_vehicle()
    actually uses (CHASSIS_DIMS, WHEEL_RADIUS/WIDTH), not arbitrary shapes.
    Not yet tested end-to-end with a real controller_manager (that needs
    step 4's plugin + step 6's launch file) — this is XML-validated
    (check_urdf) and visually confirmed in RViz (base_link + wheel frames
    at the right positions, now with real vehicle-shaped geometry too).

    Joint layout matches vehicle_native.fmu's FL/FR/RL/RR corners and its
    actual model constants (WHEELBASE=2.6, TRACK=1.5, WHEEL_RADIUS=0.32 in
    fmu/cpp/native_vehicle_fmu/sources/vehicle_native.cpp), so the numbers
    here aren't arbitrary placeholders.

    Interface types below (front=position, rear=velocity) are NOT a guess —
    checked against ros2_controllers' actual steering_controllers_library.cpp
    source (github.com/ros-controls/ros2_controllers, humble branch):
    front_wheels_names get a HW_IF_POSITION command interface (steering
    angle), rear_wheels_names get HW_IF_VELOCITY (wheel spin rate), not
    HW_IF_EFFORT. This is a real mismatch worth flagging: our FMU's
    drive_torque_rear/_mid/_front inputs are TORQUES (N*m), not velocities —
    so step 4's ChronoFmuSystemInterface can't just pass the controller's
    velocity command straight into the FMU. It will need its own small
    velocity->torque control loop (e.g. a P controller comparing commanded
    vs. measured wheel velocity), not a simple passthrough. Not implemented
    yet; noted here because the URDF's interface types are what make this
    requirement concrete.
  -->

  <material name="chassis_red">
    <color rgba="0.75 0.1 0.1 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Chassis box: CHASSIS_DIMS=(2.6, 1.6, 0.4) from simple_vehicle.py, at
       chassis_z = WHEEL_RADIUS(0.32) + SUSPENSION_TRAVEL_REST(0.32) +
       CHASSIS_CG_HEIGHT(0.55) = 1.19, matching make_vehicle()'s actual
       resting height above the wheel-axle line (base_link, at z=0, sits at
       wheel-center height — see the wheel joints' z=0.32 origins below). -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 1.19" rpy="0 0 0"/>
      <geometry>
        <box size="2.6 1.6 0.4"/>
      </geometry>
      <material name="chassis_red"/>
    </visual>
  </link>

  <!-- Front knuckles: no visual, purely a kinematic pass-through link
       between the steering revolute and the new front wheel spin joint
       below — matching vehicle_native.cpp's own body chain (upright ->
       knuckle -> wheel, spin_parent = knuckle when steered). Needed once
       front wheels got a real spin joint (4WD): a single link can't be
       the child of two independent joints, so steering and spin each need
       their own link in the chain, same as the rear axle never needed
       (rear has no steering, so rear_left/right_wheel_joint attaches
       straight to base_link). -->
  <link name="front_left_knuckle"/>
  <link name="front_right_knuckle"/>

  <!-- Wheel cylinders: WHEEL_RADIUS=0.32, WHEEL_WIDTH=0.22. URDF <cylinder>
       is always local-Z-axis, so rpy="1.5708 0 0" (90 deg about X) points
       it along Y instead — the rolling axis, matching
       ChBodyEasyCylinder(ChAxis::Y, ...) in vehicle_native.cpp. -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <!-- Front axle: steering joints (revolute about Z, matching vehicle_native.cpp's
       knuckle->wheel steer axis). ackermann_steering_controller computes the
       Ackermann-corrected left/right angles itself from one high-level
       steering command — these two joints are what it writes into. Child
       is now the knuckle (not the wheel directly) — see the knuckle link
       comment above. -->
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="1.3 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="1.3 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>

  <!-- Front axle spin (4WD): state-only, no command_interface below —
       ackermann_steering_controller has no front-traction command path at
       all (confirmed against its real source, step 3), and the 4WD P-loop
       already drives the front axle's torque from the rear-axle velocity
       command (see ChronoFmuSystemInterface's write()) — nothing should
       ever write a target here. Zero origin offset from the knuckle: the
       knuckle sits at the same point vehicle_native.cpp's knuckle body
       does, and the wheel attaches there with no further offset, same as
       vehicle_native.cpp's own knuckle->wheel revolute. -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear axle: traction (spin) joints, continuous rotation about Y
       (rolling direction), velocity-commanded per the controller source. -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-1.3 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-1.3 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="ChronoVehicleSystem" type="system">
    <hardware>
      <!-- Not yet built (step 4) — this names the plugin that step 4 will
           register via pluginlib once it exists. -->
      <plugin>chrono_ros2_control/ChronoFmuSystemInterface</plugin>
      <!-- Placeholder path — should become a launch-time substitution
           (e.g. from a launch argument) once step 6's launch file exists,
           not a hardcoded absolute path. -->
      <param name="fmu_dir">/home/daniel/chrono_test/fmu/cpp/native_vehicle_fmu</param>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- 4WD front spin: state-only, no command_interface — see the
         matching joint comment above for why nothing should ever command
         this. -->
    <joint name="front_left_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
