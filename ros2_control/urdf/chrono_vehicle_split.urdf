<?xml version="1.0"?>
<robot name="chrono_vehicle_split">

  <!--
    Split-version (스플릿 버전) counterpart of chrono_vehicle.urdf (the
    in-process/인프로세스 버전). Identical joint topology/visual geometry —
    the only difference is the <ros2_control> block's <plugin>: this one
    names chrono_split_ecu_bridge_hw_interface/ChronoEcuBridgeSystemInterface
    instead of chrono_ros2_control/ChronoFmuSystemInterface. No fmu_dir
    <param> here — that plugin has zero FMU-specific knowledge by design
    (see its own header comment); fmu_dir instead lives as a ROS2 node
    parameter on chrono_split_dynamics_node (the process that actually
    knows about the FMU), set via the split launch file.

    chrono_vehicle.urdf itself is untouched — kept as a separate sibling
    file, not edited in place, per this repo's additive-only convention.
  -->

  <material name="chassis_red">
    <color rgba="0.75 0.1 0.1 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 1.19" rpy="0 0 0"/>
      <geometry>
        <box size="2.6 1.6 0.4"/>
      </geometry>
      <material name="chassis_red"/>
    </visual>
  </link>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.32" length="0.22"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="1.3 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="1.3 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="100" velocity="10"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-1.3 0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-1.3 -0.75 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <ros2_control name="ChronoVehicleSystem" type="system">
    <hardware>
      <plugin>chrono_split_ecu_bridge_hw_interface/ChronoEcuBridgeSystemInterface</plugin>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
