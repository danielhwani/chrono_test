<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chrono_split_ecu_bridge_hw_interface</name>
  <version>0.1.0</version>
  <description>
    hardware_interface::SystemInterface plugin that bridges ros2_control to
    a downstream ECU node over chrono_split_msgs/EcuCommand+EcuStatus
    (Bridge 1 of the split ros2_control/ECU/FMU-dynamics architecture) --
    see ../../README.md.
  </description>
  <maintainer email="danielhwani@gmail.com">daniel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>chrono_split_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>chrono_split_ecu</exec_depend>
  <exec_depend>chrono_split_dynamics_node</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
